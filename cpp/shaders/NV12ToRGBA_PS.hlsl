// =============================================================================
// NV12ToRGBA_PS.hlsl - NV12からRGBAへの変換ピクセルシェーダー
// =============================================================================
//
// 機能:
//   - NV12フォーマット（Y平面 + UV平面）をRGBAに変換
//   - BT.709色空間変換行列を使用
//   - GPUで高速に色空間変換を実行（Zero-Copy対応）
//
// NV12フォーマット:
//   - Y平面: 輝度（8bit、フル解像度）
//   - UV平面: 色差（8bit x 2、水平・垂直ともに半分の解像度）
//
// =============================================================================

// Y平面テクスチャ（R8_UNORM または単一チャンネル）
Texture2D<float> luminanceTexture : register(t0);

// UV平面テクスチャ（R8G8_UNORM、Uが赤、Vが緑）
Texture2D<float2> chrominanceTexture : register(t1);

// リニアサンプラー（バイリニア補間）
SamplerState linearSampler : register(s0);

// ピクセルシェーダー入力構造体
struct PSInput
{
    float4 position : SV_POSITION;  // スクリーン座標
    float2 texCoord : TEXCOORD0;    // テクスチャ座標
};

// =============================================================================
// BT.709 YUV to RGB 変換定数
// =============================================================================
// ITU-R BT.709 (HDTV) の変換行列
// 
// RGB = YUVtoRGB * (Y - 16/255, U - 128/255, V - 128/255)
//
// Y:  16 ~ 235 (リミテッドレンジ)
// UV: 16 ~ 240 (中心 128)
// =============================================================================

static const float3x3 YUVtoRGB_BT709 = float3x3(
    1.164384f,  0.000000f,  1.792741f,  // R = 1.164 * Y + 1.793 * V
    1.164384f, -0.213249f, -0.532909f,  // G = 1.164 * Y - 0.213 * U - 0.533 * V
    1.164384f,  2.112402f,  0.000000f   // B = 1.164 * Y + 2.112 * U
);

// リミテッドレンジのオフセット
static const float Y_OFFSET = 16.0f / 255.0f;
static const float UV_OFFSET = 128.0f / 255.0f;

// =============================================================================
// メインエントリーポイント
// =============================================================================
float4 main(PSInput input) : SV_TARGET
{
    // Y成分をサンプリング（輝度）
    float y = luminanceTexture.Sample(linearSampler, input.texCoord);
    
    // UV成分をサンプリング（色差）
    // NV12のUV平面はYの半分の解像度なので、バイリニア補間で拡大
    float2 uv = chrominanceTexture.Sample(linearSampler, input.texCoord);
    
    // リミテッドレンジからフルレンジへ変換
    // Y: [16/255, 235/255] -> [0, 1]
    // UV: [16/255, 240/255] with center at 128/255 -> [-0.5, 0.5]
    float y_adjusted = y - Y_OFFSET;
    float u = uv.x - UV_OFFSET;  // Cb (青色差)
    float v = uv.y - UV_OFFSET;  // Cr (赤色差)
    
    // YUVベクトル
    float3 yuv = float3(y_adjusted, u, v);
    
    // BT.709 YUV to RGB 変換
    float3 rgb = mul(YUVtoRGB_BT709, yuv);
    
    // 出力を[0, 1]にクランプ
    rgb = saturate(rgb);
    
    // アルファは常に1.0（不透明）
    return float4(rgb, 1.0f);
}

