// =============================================================================
// Passthrough_VS.hlsl - パススルー頂点シェーダー
// =============================================================================
// 
// 機能:
//   - フルスクリーンクアッド描画用の頂点シェーダー
//   - 頂点座標とテクスチャ座標をそのまま出力
//
// 入力:
//   - position: クリップ空間座標 (-1 ~ +1)
//   - texcoord: テクスチャ座標 (0 ~ 1)
//
// =============================================================================

// 頂点シェーダー入力構造体
struct VSInput
{
    float3 position : POSITION;   // 頂点位置
    float2 texCoord : TEXCOORD0;  // テクスチャ座標
};

// ピクセルシェーダーへの出力構造体
struct PSInput
{
    float4 position : SV_POSITION;  // スクリーン座標
    float2 texCoord : TEXCOORD0;    // テクスチャ座標
};

// =============================================================================
// メインエントリーポイント
// =============================================================================
PSInput main(VSInput input)
{
    PSInput output;
    
    // 位置をそのまま出力（クリップ空間座標）
    output.position = float4(input.position, 1.0f);
    
    // テクスチャ座標をそのまま出力
    output.texCoord = input.texCoord;
    
    return output;
}
